# MeshDock configuration
# Prefer: python3 scripts/setup.py --demo (generates a unique password).
# Manual setup: copy this file to .env and replace the password before starting.
# Never commit .env, real credentials, server addresses or private keys.
MESHDOCK_ADMIN_USERNAME=admin
MESHDOCK_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
MESHDOCK_PUBLIC_ORIGIN=http://localhost:8080
MESHDOCK_DOMAIN=localhost
MESHDOCK_COOKIE_SECURE=false
MESHDOCK_DEMO=true
MESHDOCK_PORT=8080

# dev.sh always overrides MESHDOCK_DEMO: demo by default, real only with --prod.
# It also sets loopback origin/cookies and isolates data/keys in .data/demo or
# .data/prod, regardless of inherited MESHDOCK_DATA_DIR or MESHDOCK_MASTER_KEY_FILE.
# For a real Docker deployment, set MESHDOCK_DEMO=false, use an HTTPS public origin,
# set MESHDOCK_DOMAIN to your domain and MESHDOCK_COOKIE_SECURE=true. Alternatively generate
# production configuration with scripts/setup.py --origin https://meshdock.example.com.
