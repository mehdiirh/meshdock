msgid "applying"
msgstr "Activating a new generation."

msgid "body_too_large"
msgstr "The request is too large."

msgid "capacity"
msgstr "The connection slot limit has been reached."

msgid "checking"
msgstr "Checking service health."

msgid "credential_in_use"
msgstr "This credential is used by a server or deployed generation."

msgid "csrf"
msgstr "Refresh the page and try again."

msgid "deployment_queued"
msgstr "Deployment queued."

msgid "duplicate_host"
msgstr "A host may only appear once in the inventory."

msgid "forbidden"
msgstr "This action is not permitted."

msgid "health_failed"
msgstr ""
"A managed service or destination did not become ready. Check the named service/endpoint, peer "
"connectivity, transport ports and the destination application."

msgid "host_key_changed"
msgstr "SSH host key did not match the trusted fingerprint."

msgid "install_failed"
msgstr "Dependency installation failed."

msgid "invalid_key"
msgstr "The private key or passphrase is invalid."

msgid "invalid_login"
msgstr "Invalid username or password."

msgid "invalid_state"
msgstr "This action is unavailable in the current state."

msgid "invalid_topology"
msgstr "The topology is invalid."

msgid "not_found"
msgstr "Resource not found."

msgid "ownership_conflict"
msgstr "An unmanaged resource conflicts with this deployment."

msgid "pool_policy"
msgstr "Connections sharing a public port must use the same balancing policy."

msgid "port_conflict"
msgstr "Public ports must be unique within a connection."

msgid "preflight_failed"
msgstr "Server preflight checks failed."

msgid "preparing"
msgstr "Preparing servers."

msgid "rate_limit"
msgstr "Too many attempts. Try again later."

msgid "recovered"
msgstr "Previous configuration restored. A new deployment may now be requested."

msgid "recovery_required"
msgstr "A server is unreachable; recovery is required."

msgid "remote"
msgstr "Remote server output."

msgid "remote_failed"
msgstr "A remote operation failed. See the deployment phase."

msgid "reserved_port"
msgstr "The port conflicts with a management or transport listener. Check the current mappings."

msgid "retrying"
msgstr "Retry scheduled."

msgid "revision_conflict"
msgstr "The topology changed. Refresh before saving."

msgid "rolled_back"
msgstr "Previous generation restored."

msgid "rolling_back"
msgstr "Restoring the previous generation."

msgid "ssh_auth"
msgstr ""
"Root SSH login was rejected. Check the saved password/key and whether the server permits root "
"login with that method."

msgid "ssh_unreachable"
msgstr ""
"Cannot reach management SSH. Check the server address, SSH port and firewall access from the "
"MeshDock worker."

msgid "succeeded"
msgstr "Deployment is healthy."

msgid "superseded"
msgstr "Replaced by a newer topology revision."

msgid "topology_cycle"
msgstr "Connections must not form a cycle."

msgid "unauthorized"
msgstr "Sign in to continue."

msgid "validation_error"
msgstr "Check the highlighted values."

msgid "worker_claimed"
msgstr "Worker started deployment."

msgid "worker_error"
msgstr "Deployment failed; recovery details are recorded below."

msgid "cleanup_first"
msgstr "Clean up managed connections before removing the helper."

msgid "stale_worker"
msgstr "A newer worker owns this deployment."

msgid "control_port_conflict"
msgstr "The transport port conflicts with another listener on this server."

msgid "mapping_limit"
msgstr ""
"This method cannot deploy this many mapped ports. Reduce the range or choose a method with native"
" ranges."

msgid "ssh_port_conflict"
msgstr "The mapping includes the entry server’s SSH port. Add it to the explicit exceptions."

msgid "range_pool_conflict"
msgstr ""
"A GRE range or UDP mapping overlaps another connection using the same protocol on this entry. Use disjoint ranges or explicit "
"exceptions."

msgid "port_capacity"
msgstr "No free transport listener allocation remains on this server."

msgid "public_address_missing"
msgstr "The configured public IPv4 must be assigned to a local interface on this server."

msgid "range_kernel_unsupported"
msgstr "Shifted UDP port ranges require Linux kernel 4.18 or newer."

msgid "listener_conflict"
msgstr ""
"An existing service occupies a required listener. Add an exception or change the mapping/control "
"port. Conflict details follow."

msgid "range_target_conflict"
msgstr "The GRE destination would loop back into its own forwarding listener."

msgid "descriptor_capacity"
msgstr ""
"The server file-descriptor limits cannot accommodate this deployment. Review the required and "
"available capacity."

msgid "outgoing_port_capacity"
msgstr "The planned listeners occupy all automatic outgoing ports for a protocol. Add explicit exceptions within the reported range on this server. A different listener IP alone may not free outgoing ports."

msgid "invalid_method_settings"
msgstr "Invalid method settings. Check supported options, limits, and dependencies."

msgid "transport_architecture_unsupported"
msgstr ""
"The pinned Rathole ARM64 release does not include WebSocket. Select TCP, Noise or TLS, or use "
"x86_64 servers for WS/WSS. No existing tunnel was replaced."

msgid "deployment_cancelled"
msgstr ""
"Deployment cancelled. No new steps will run; any activated changes were rolled back. The desired "
"topology remains editable."

msgid "command_timeout"
msgstr ""
"A server operation timed out. Check the reported command and server connectivity; rollback "
"follows before another attempt."

msgid "package_lock"
msgstr ""
"Another package manager holds the installation lock. Let the existing update finish, then retry. "
"Do not delete package lock files."

msgid "package_dns"
msgstr ""
"The server cannot resolve a package repository hostname. Fix DNS/outbound access on that server, "
"then retry."

msgid "package_repository"
msgstr ""
"A configured package repository is invalid or has no Release file. Repair the server’s APT "
"repository configuration, then retry."

msgid "disk_full"
msgstr "The server has no disk space left. Free space for packages and managed generations, then retry."

msgid "package_missing"
msgstr ""
"A required package is absent from the server’s package indexes. Check enabled Ubuntu/Debian "
"repositories and update the indexes."

msgid "package_tls"
msgstr ""
"TLS verification of a package repository failed. Check the server clock, CA certificates and "
"repository HTTPS configuration."

msgid "dependencies_checking"
msgstr "Checking required packages."

msgid "packages_installing"
msgstr "Installing missing packages; the current package operation may take several minutes."

msgid "dependencies_ready"
msgstr "Required packages are ready."

msgid "binary_downloading"
msgstr "Downloading the pinned transport binary."

msgid "binary_verified"
msgstr "Transport binary checksum verified."

msgid "preflight_checking"
msgstr "Checking server prerequisites, ownership, listeners and capacity."

msgid "preflight_passed"
msgstr "Server preflight checks passed."

msgid "configuration_validating"
msgstr "Staged files written; validating configuration before activation."

msgid "configuration_ready"
msgstr "Configuration validated and ready for activation."


msgid "package_network"
msgstr "The package repository connection failed. Check outbound connectivity and the reported package command; MeshDock uses IPv4 for package downloads."

msgid "removal_busy"
msgstr "Wait for the current deployment to finish before retrying or restoring a removal."

msgid "restore_endpoint_changed"
msgstr "The endpoint settings changed after deployment. Restore those settings before restoring this connection."

msgid "ssh_jump_unreachable"
msgstr "The SSH jump host is unreachable. Check its address, port and controller access."

msgid "ssh_jump_auth"
msgstr "SSH jump-host authentication failed. Check its username and saved credential."

msgid "ssh_jump_host_key_changed"
msgstr "The SSH jump host key changed. Verify its fingerprint before reconnecting."

msgid "ssh_jump_forward_failed"
msgstr "The jump host could not open the target SSH connection. Check TCP forwarding permission and target reachability from the jump host."

msgid "force_delete_busy"
msgstr "Finish or review the current force deletion before changing the topology."

msgid "force_delete_recovery_conflict"
msgstr "An unrelated deployment still needs recovery. Recover it before forcing this server deletion."

msgid "force_delete_skip_denied"
msgstr "Only endpoints confirmed unreachable during this cleanup can be skipped. Retry or resolve the reported cleanup error."

msgid "force_delete_started"
msgstr "Checking and cleaning every affected endpoint before forced deletion."

msgid "force_delete_checking"
msgstr "Checking authenticated SSH access to this endpoint."

msgid "force_delete_cleaned"
msgstr "Endpoint cleanup completed; unrelated connections were preserved."

msgid "force_delete_skipped"
msgstr "Cleanup was skipped for this unreachable endpoint. Remote resources may remain."

msgid "force_delete_attention"
msgstr "Reachable endpoints were processed. Review remaining endpoints, retry cleanup or explicitly skip unreachable cleanup."

msgid "force_delete_orphans"
msgstr "Server deletion completed with skipped cleanup. Resources may remain on the reported unreachable endpoints."

msgid "force_delete_complete"
msgstr "The server and its connections were removed after endpoint cleanup."

msgid "board_server_in_use"
msgstr "This server has a tunnel or SSH jump connection. Remove those connections and complete any pending cleanup before moving it to inventory."

msgid "mapping_protocol_unsupported"
msgstr "The selected method or transport does not support this mapping protocol. Choose a compatible transport or change the mapping protocol."

msgid "health_gre_peer_message"
msgstr "GRE peer {peer} did not answer through interface {interface}."

msgid "health_gre_peer_hint"
msgstr "Check both tunnel endpoints, GRE (IP protocol 47, not port 47), and ICMP inside the tunnel. A failed ping alone does not prove where traffic is blocked."

msgid "health_service_message"
msgstr "Managed service {unit} is not active."

msgid "health_service_hint"
msgstr "Inspect this service’s status and system journal on the named server for its startup failure. Raw service output is not included because it may contain secrets."

msgid "health_firewall_message"
msgstr "Managed firewall jump to {chain} is missing from {table}/{parent}."

msgid "health_firewall_hint"
msgstr "Check whether another firewall manager removed MeshDock’s rules. Do not flush unrelated firewall rules."

msgid "health_listener_message"
msgstr "{missing} required {protocol} listener(s) are missing; first missing endpoint: {address}:{port}."

msgid "health_listener_hint"
msgstr "Check the managed proxy/tunnel service, bind addresses, and listener capacity. This checks tunnel listeners, not whether every destination application is running."

msgid "health_listener_scan_message"
msgstr "Could not interpret the server’s {protocol} listener list."

msgid "health_listener_scan_hint"
msgstr "Inspect the server’s iproute2/ss version and output format. The listener state could not be verified."

msgid "health_connection_message"
msgstr "TCP readiness connection to {address}:{port} failed."

msgid "health_connection_hint"
msgstr "Check that this endpoint is listening and reachable from the named server. This is a TCP connection test, not an application login or end-to-end traffic test."

msgid "health_retry"
msgstr "Health check failed; retrying before rollback."

msgid "health_retry_message"
msgstr "Health probe {attempt}/{limit} failed; retrying. {message}"

msgid "health_unknown_hint"
msgstr "This report did not record the individual health check. Its cause cannot be determined from this message alone."
