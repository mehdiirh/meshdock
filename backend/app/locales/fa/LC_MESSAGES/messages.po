msgid "applying"
msgstr "در حال فعال‌سازی نسخه جدید."

msgid "body_too_large"
msgstr "درخواست بیش از حد بزرگ است."

msgid "capacity"
msgstr "ظرفیت اتصال‌ها تکمیل شده است."

msgid "checking"
msgstr "در حال بررسی سلامت سرویس‌ها."

msgid "credential_in_use"
msgstr "این اطلاعات ورود در یک سرور یا نسخه مستقر استفاده می‌شود."

msgid "csrf"
msgstr "صفحه را تازه‌سازی کرده و دوباره تلاش کنید."

msgid "deployment_queued"
msgstr "استقرار در صف قرار گرفت."

msgid "duplicate_host"
msgstr "هر میزبان فقط یک بار می‌تواند در فهرست باشد."

msgid "forbidden"
msgstr "اجازه انجام این کار را ندارید."

msgid "health_failed"
msgstr ""
"سرویس مدیریت‌شده یا مقصد آماده نشد. سرویس یا آدرس مشخص‌شده، ارتباط سرورها، پورت انتقال و برنامهٔ "
"مقصد را بررسی کنید."

msgid "host_key_changed"
msgstr "اثر انگشت کلید میزبان SSH با مقدار تأییدشده مطابقت ندارد."

msgid "install_failed"
msgstr "نصب وابستگی‌ها ناموفق بود."

msgid "invalid_key"
msgstr "کلید خصوصی یا عبارت عبور نامعتبر است."

msgid "invalid_login"
msgstr "نام کاربری یا گذرواژه نادرست است."

msgid "invalid_state"
msgstr "این عملیات در وضعیت فعلی ممکن نیست."

msgid "invalid_topology"
msgstr "توپولوژی معتبر نیست."

msgid "not_found"
msgstr "مورد موردنظر پیدا نشد."

msgid "ownership_conflict"
msgstr "یک منبع خارج از مدیریت با این استقرار تداخل دارد."

msgid "pool_policy"
msgstr "اتصال‌های دارای پورت مشترک باید سیاست توزیع یکسان داشته باشند."

msgid "port_conflict"
msgstr "در هر اتصال پورت‌های عمومی باید یکتا باشند."

msgid "preflight_failed"
msgstr "بررسی اولیه سرور ناموفق بود."

msgid "preparing"
msgstr "در حال آماده‌سازی سرورها."

msgid "rate_limit"
msgstr "تلاش‌های زیادی انجام شده؛ بعداً دوباره تلاش کنید."

msgid "recovered"
msgstr "پیکربندی قبلی بازیابی شد. اکنون می‌توانید استقرار جدیدی درخواست کنید."

msgid "recovery_required"
msgstr "یک سرور در دسترس نیست؛ بازیابی لازم است."

msgid "remote"
msgstr "خروجی سرور راه دور."

msgid "remote_failed"
msgstr "یک عملیات روی سرور ناموفق بود. مرحله استقرار را بررسی کنید."

msgid "reserved_port"
msgstr "پورت با یک شنونده مدیریت یا تونل تداخل دارد. نگاشت‌های فعلی را بررسی کنید."

msgid "retrying"
msgstr "تلاش دوباره زمان‌بندی شد."

msgid "revision_conflict"
msgstr "توپولوژی تغییر کرده است؛ پیش از ذخیره صفحه را تازه‌سازی کنید."

msgid "rolled_back"
msgstr "نسخه قبلی بازیابی شد."

msgid "rolling_back"
msgstr "در حال بازیابی نسخه قبلی."

msgid "ssh_auth"
msgstr "ورود SSH با root رد شد. رمز یا کلید ذخیره‌شده و مجازبودن این روش ورود root را بررسی کنید."

msgid "ssh_unreachable"
msgstr "دسترسی به SSH مدیریتی ممکن نیست. آدرس، پورت SSH و دسترسی فایروال از پردازشگر مش‌داک را بررسی کنید."

msgid "succeeded"
msgstr "استقرار با موفقیت انجام شد."

msgid "superseded"
msgstr "با نسخه جدیدتر توپولوژی جایگزین شد."

msgid "topology_cycle"
msgstr "اتصال‌ها نباید یک چرخه تشکیل دهند."

msgid "unauthorized"
msgstr "برای ادامه وارد شوید."

msgid "validation_error"
msgstr "مقادیر واردشده را بررسی کنید."

msgid "worker_claimed"
msgstr "اجرای استقرار آغاز شد."

msgid "worker_error"
msgstr "استقرار ناموفق بود؛ جزئیات بازیابی ثبت شده است."

msgid "cleanup_first"
msgstr "پیش از حذف ابزار مدیریت، اتصال‌های مدیریت‌شده را پاک‌سازی کنید."

msgid "stale_worker"
msgstr "یک پردازشگر جدیدتر مدیریت این استقرار را بر عهده دارد."

msgid "control_port_conflict"
msgstr "پورت انتقال با پورت اتصال دیگری در این سرور تداخل دارد."

msgid "mapping_limit"
msgstr ""
"این روش از این تعداد پورت نگاشت‌شده پشتیبانی نمی‌کند. بازه را کوچک‌تر کنید یا روشی با پشتیبانی "
"بومی از بازه انتخاب کنید."

msgid "ssh_port_conflict"
msgstr "نگاشت شامل پورت SSH سرور ورودی است. آن را به استثناهای صریح اضافه کنید."

msgid "range_pool_conflict"
msgstr ""
"بازه بومی GRE با اتصال دیگری روی این ورودی هم‌پوشانی دارد. بازه‌های جدا یا استثناهای صریح تعریف "
"کنید."

msgid "port_capacity"
msgstr "پورت آزادی برای شنونده داخلی تونل روی این سرور باقی نمانده است."

msgid "public_address_missing"
msgstr "آدرس IPv4 عمومی تنظیم‌شده باید روی یکی از رابط‌های محلی این سرور قرار داشته باشد."

msgid "range_kernel_unsupported"
msgstr "نگاشت بازه GRE با تغییر شماره پورت به کرنل لینوکس نسخه ۴٫۱۸ یا جدیدتر نیاز دارد."

msgid "listener_conflict"
msgstr ""
"یک سرویس موجود پورت موردنیاز را اشغال کرده است. استثنا اضافه کنید یا نگاشت یا پورت کنترل را تغییر"
" دهید. جزئیات تداخل در ادامه آمده است."

msgid "range_target_conflict"
msgstr "بازه‌های مقصد GRE برای میزبان‌های مقصد متفاوت در یک اتصال هم‌پوشانی دارند."

msgid "descriptor_capacity"
msgstr ""
"محدودیت توصیفگرهای فایل سرور برای این استقرار کافی نیست. ظرفیت موردنیاز و ظرفیت در دسترس را بررسی"
" کنید."

msgid "outgoing_port_capacity"
msgstr ""
"این نگاشت همهٔ پورت‌های خودکار خروجی TCP را روی آدرس خروجی سرور اشغال می‌کند. در بازهٔ گزارش‌شده "
"استثناهای صریح اضافه کنید، از آدرس ورودی جداگانه استفاده کنید یا انتقال هسته را انتخاب کنید."

msgid "invalid_method_settings"
msgstr "تنظیمات روش نامعتبر است. گزینه‌های مجاز، محدودیت‌ها و وابستگی‌ها را بررسی کنید."

msgid "transport_architecture_unsupported"
msgstr ""
"نسخه ARM64 انتخاب‌شدهٔ Rathole وب‌سوکت ندارد. TCP، Noise یا TLS را انتخاب کنید، یا برای WS/WSS از"
" سرور x86_64 استفاده کنید. تونل قبلی جایگزین نشده است."

msgid "deployment_cancelled"
msgstr ""
"استقرار لغو شد. مرحلهٔ جدیدی اجرا نمی‌شود و تغییرات فعال‌شده به حالت قبل بازگردانده شدند. "
"توپولوژی درخواستی همچنان قابل ویرایش است."

msgid "command_timeout"
msgstr ""
"مهلت عملیات سرور پایان یافت. فرمان گزارش‌شده و ارتباط سرور را بررسی کنید؛ پیش از تلاش مجدد "
"بازگردانی انجام می‌شود."

msgid "package_lock"
msgstr ""
"قفل نصب در اختیار مدیر بستهٔ دیگری است. پس از اتمام به‌روزرسانی دوباره تلاش کنید. فایل قفل بسته "
"را حذف نکنید."

msgid "package_dns"
msgstr "سرور نمی‌تواند نام مخزن بسته را پیدا کند. DNS یا دسترسی خروجی آن سرور را اصلاح و دوباره تلاش کنید."

msgid "package_repository"
msgstr "مخزن بسته نامعتبر است یا فایل Release ندارد. تنظیمات مخزن APT سرور را اصلاح و دوباره تلاش کنید."

msgid "disk_full"
msgstr "فضای دیسک سرور پر است. برای بسته‌ها و نسل‌های مدیریت‌شده فضا آزاد و دوباره تلاش کنید."

msgid "package_missing"
msgstr "بستهٔ لازم در فهرست سرور یافت نشد. مخازن فعال Ubuntu/Debian و فهرست بسته‌ها را بررسی کنید."

msgid "package_tls"
msgstr "تأیید TLS مخزن بسته ناموفق بود. ساعت سرور، گواهی‌های CA و تنظیمات HTTPS مخزن را بررسی کنید."

msgid "dependencies_checking"
msgstr "در حال بررسی بسته‌های لازم."

msgid "packages_installing"
msgstr "در حال نصب بسته‌های لازم؛ عملیات جاری ممکن است چند دقیقه طول بکشد."

msgid "dependencies_ready"
msgstr "بسته‌های لازم آماده‌اند."

msgid "binary_downloading"
msgstr "در حال دریافت باینری نسخهٔ مشخص‌شدهٔ تونل."

msgid "binary_verified"
msgstr "Checksum باینری تونل تأیید شد."

msgid "preflight_checking"
msgstr "در حال بررسی پیش‌نیازها، مالکیت منابع، شنونده‌ها و ظرفیت سرور."

msgid "preflight_passed"
msgstr "بررسی پیش‌نیازهای سرور موفق بود."

msgid "configuration_validating"
msgstr "فایل‌های آماده نوشته شدند؛ تنظیمات پیش از فعال‌سازی بررسی می‌شوند."

msgid "configuration_ready"
msgstr "تنظیمات تأیید شده و آمادهٔ فعال‌سازی هستند."


msgid "package_network"
msgstr "ارتباط با مخزن بسته ناموفق بود. دسترسی خروجی و فرمان بستهٔ گزارش‌شده را بررسی کنید؛ دریافت بسته در مش‌داک از IPv4 استفاده می‌کند."

msgid "removal_busy"
msgstr "پیش از تلاش مجدد یا بازگردانی اتصال، منتظر پایان استقرار جاری بمانید."

msgid "restore_endpoint_changed"
msgstr "تنظیمات سرور پس از استقرار تغییر کرده است. پیش از بازگردانی اتصال، تنظیمات قبلی سرور را بازگردانید."
