# Opt-in isolated Linux network tests. Never use this image for the control plane.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
USER root
RUN python -m pip install --no-cache-dir uv==0.11.14
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends iproute2 iptables iputils-ping && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project
COPY app ./app
COPY tests ./tests
ENTRYPOINT []
ENV TM_TEST_LINUX_NETWORK=1 TM_DATA_DIR=/tmp/tunnel-manager-tests
CMD ["uv", "run", "--no-sync", "pytest", "-q", "tests/test_gre_linux.py"]
