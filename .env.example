# MeshDock configuration
# Prefer: python3 scripts/setup.py --demo (generates a unique password).
# Manual setup: copy this file to .env and replace the password before starting.
# Never commit .env, real credentials, server addresses or private keys.
TM_ADMIN_USERNAME=admin
TM_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
TM_PUBLIC_ORIGIN=http://localhost:8080
TM_DOMAIN=localhost
TM_COOKIE_SECURE=false
TM_DEMO=true
TM_PORT=8080

# dev.sh always overrides TM_DEMO: demo by default, real only with --prod.
# It also sets loopback origin/cookies and isolates data/keys in .data/demo or
# .data/prod, regardless of inherited TM_DATA_DIR or TM_MASTER_KEY_FILE.
# For a real Docker deployment, set TM_DEMO=false, use an HTTPS public origin,
# set TM_DOMAIN to your domain and TM_COOKIE_SECURE=true. Alternatively generate
# production configuration with scripts/setup.py --origin https://meshdock.example.com.
